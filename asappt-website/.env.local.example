# Anthropic Claude API (for insurance/FAQ chatbot)
ANTHROPIC_API_KEY=sk-ant-...

# Google Cloud project ID (Vision API)
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Google Service Account JSON (one line, stringified)
# {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Drive folder ID for Patient Intakes
# From folder URL: drive.google.com/drive/folders/{THIS_ID}
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
